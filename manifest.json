{
  "manifest_version": 3,
  "name": "Keyboard Overlay",
  "description": "Shows your keystrokes and keyboard shortcuts on screen during demos and recordings.",
  "version": "1.8.0",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "icons": { "16": "icons/key-16.png", "32": "icons/key-32.png", "48": "icons/key-48.png", "128": "icons/key-128.png" },
  "action": {
    "default_title": "Keyboard Overlay settings",
    "default_icon": { "16": "icons/key-16.png", "32": "icons/key-32.png" }
  },
  "background": { "service_worker": "frames.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "all_frames": true,
    "match_about_blank": true,
    "js": ["settings.js", "overlay.js"],
    "run_at": "document_start"
  }]
}
